PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/vox_ai_studio?schema=public
JWT_SECRET=replace_with_64_char_random_hex_secret
APP_API_KEY=replace_with_personal_mobile_app_api_key

# AI Provider Settings: "xtts" or "elevenlabs"
AI_PROVIDER=xtts
AI_INFERENCE_URL=https://your-separate-xtts-gpu-endpoint.example.com
AI_PROVIDER_API_KEY=optional_for_xtts_required_for_external_api

# Persistent S3-Compatible Object Storage (Cloudflare R2, AWS S3, Backblaze B2, Supabase Storage)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=vox-ai-studio-media
STORAGE_ACCESS_KEY=your_s3_access_key
STORAGE_SECRET_KEY=your_s3_secret_key
